<?xml version="1.0" encoding="utf-8"?>
<!--
  The custom player overlay. It sits on top of the PlayerView (whose built-in
  controller is disabled) and is populated from PlayerControlRegistry:
  - the centre holds the play/pause control;
  - the bottom panel holds the progress row (optional) and the configurable
    button row, in the user's saved order.
  Not clickable by default so taps reach the video surface underneath.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <!-- Darkens the top/bottom edges so white icons stay readable. -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:importantForAccessibility="no" />

    <!-- Big centre play / pause. -->
    <ImageButton
        android:id="@+id/centerPlayPause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_center_button"
        android:contentDescription="@string/control_play_pause"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/white" />

    <ProgressBar
        android:id="@+id/overlayBuffering"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <!-- Bottom panel: progress + configurable button row. -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/progressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="?attr/accent"
                android:thumbTint="?attr/accent" />

            <TextView
                android:id="@+id/timeDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="44dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:text="0:00" />
        </LinearLayout>
        <HorizontalScrollView
            android:id="@+id/controlsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/controlsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
